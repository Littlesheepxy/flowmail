## Step 2：字段抽取

### 审批场景抽取 Schema

```typescript
export const ApprovalExtractionSchema = z.object({
  title: z.string().describe("审批事项标题，简洁描述"),
  requester: z.object({
    name: z.string(),
    email: z.string().email(),
  }).describe("申请人信息"),
  requestContent: z.string().describe("申请内容摘要，100字以内"),
  amount: z.number().optional().describe("涉及金额（如有），单位元"),
  currency: z.string().optional().describe("货币单位，如 CNY/USD"),
  deadline: z.string().optional().describe("需要审批完成的截止时间，ISO 8601格式"),
  urgency: z.enum(["low", "normal", "high", "urgent"]).describe("紧急程度"),
  attachmentSummary: z.string().optional().describe("附件摘要（如有）"),
});

export type ApprovalExtraction = z.infer<typeof ApprovalExtractionSchema>;
```

### 汇报跟踪场景抽取 Schema

```typescript
export const ReportExtractionSchema = z.object({
  title: z.string().describe("汇报标题"),
  reporter: z.object({
    name: z.string(),
    email: z.string().email(),
  }),
  period: z.object({
    type: z.enum(["daily", "weekly", "monthly", "ad_hoc"]),
    startDate: z.string().optional(),
    endDate: z.string().optional(),
  }).describe("汇报周期"),
  keyPoints: z.array(z.string()).max(5).describe("核心要点，最多5条"),
  completedItems: z.array(z.string()).describe("已完成事项"),
  inProgressItems: z.array(z.string()).describe("进行中事项"),
  blockers: z.array(z.string()).describe("阻塞项/风险"),
  nextActions: z.array(z.string()).describe("下一步计划"),
  overallStatus: z.enum(["on_track", "at_risk", "blocked"]).describe("整体状态"),
});

export type ReportExtraction = z.infer<typeof ReportExtractionSchema>;
```

### 使用 Vercel AI SDK structured output

```typescript
import { generateObject } from "ai";
import { openai } from "@ai-sdk/openai";

export async function extractApprovalFields(emailContent: string) {
  const { object } = await generateObject({
    model: openai("gpt-4o"),
    schema: ApprovalExtractionSchema,
    prompt: `
从以下邮件中提取审批相关信息。如果某项信息不存在，返回 null 或省略该字段。

邮件内容：
${emailContent}
    `.trim(),
  });

  return object;
}
```

