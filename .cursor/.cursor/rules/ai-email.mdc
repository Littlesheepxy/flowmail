## Step 4：状态初始化规则

```typescript
// 根据分类和抽取结果确定初始状态
export function determineInitialStatus(
  type: EntityType,
  extraction: ApprovalExtraction | ReportExtraction
): EntityStatus {
  switch (type) {
    case "approval":
      return "pending";  // 审批默认待处理
    case "report":
      const report = extraction as ReportExtraction;
      if (report.overallStatus === "blocked") return "blocked";
      return "in_progress";
    default:
      return "open";
  }
}
```

