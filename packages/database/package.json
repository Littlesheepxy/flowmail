{
	"dependencies": {
		"@paralleldrive/cuid2": "^3.1.0",
		"@prisma/adapter-pg": "^6.19.0",
		"@prisma/client": "7.1.0",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.44.7",
		"drizzle-zod": "0.8.3",
		"pg": "^8.16.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@repo/tsconfig": "workspace:*",
		"@types/node": "26.6.5",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "^0.31.11",
		"prisma": "7.10.1",
		"prisma-zod-generator": "3.3.1"
	},
	"main": "./index.ts",
	"exports": {
		".": "./index.ts"
	},
	"name": "@repo/database",
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"generate": "dotenv -c -e ../../.env -- prisma generate --no-hints",
		"push": "dotenv -c -e ../../.env -- prisma db push",
		"migrate": "dotenv -c -e ../../.env -- prisma migrate dev",
		"studio": "dotenv -c -e ../../.env -- prisma studio",
		"seed:flowmail": "dotenv -c -e ../../.env.local -- tsx prisma/seed-flowmail.ts",
		"type-check": "tsc --noEmit"
	},
	"types": "./**/.tsx",
	"version": "0.0.0"
}
