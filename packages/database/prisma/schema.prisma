datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./zod"
  config   = "./zod-generator.config.json"
}

model User {
  id                 String          @id @default(cuid())
  name               String
  email              String
  emailVerified      Boolean
  image              String?
  createdAt          DateTime
  updatedAt          DateTime
  username           String?
  role               String?
  banned             Boolean?
  banReason          String?
  banExpires         DateTime?
  onboardingComplete Boolean         @default(false)
  paymentsCustomerId String?
  locale             String?
  displayUsername     String?
  twoFactorEnabled   Boolean?
  sessions           Session[]
  accounts           Account[]
  passkeys           Passkey[]
  invitations        Invitation[]
  purchases          Purchase[]
  members            Member[]
  twofactors         TwoFactor[]
  assignedEntities   FlowEntity[]    @relation("AssignedEntities")
  timelineActions    TimelineEvent[] @relation("TimelineActor")
  notifications      Notification[]  @relation("UserNotifications")

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  activeOrganizationId String?

  token     String
  createdAt DateTime
  updatedAt DateTime

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  idToken      String?   @db.Text
  expiresAt    DateTime?
  password     String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime

  createdAt DateTime?
  updatedAt DateTime?

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id          String @id @default(cuid())
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id                 String            @id @default(cuid())
  name               String
  slug               String?
  logo               String?
  createdAt          DateTime
  metadata           String?
  paymentsCustomerId String?
  members            Member[]
  invitations        Invitation[]
  purchases          Purchase[]
  emailConnections   EmailConnection[]
  emailThreads       EmailThread[]
  flowEntities       FlowEntity[]
  categories         Category[]
  apiTokens          ApiToken[]
  notifications      Notification[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum PurchaseType {
  SUBSCRIPTION
  ONE_TIME
}

model Purchase {
  id             String        @id @default(cuid())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  type           PurchaseType
  customerId     String
  subscriptionId String?       @unique
  productId      String
  status         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([subscriptionId])
  @@map("purchase")
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("waitlist_entry")
}

// ─── Flowmail: Email Connection ───

model EmailConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String       // "gmail" | "feishu" | "dingtalk" | "wecom" | "outlook" | "imap"
  authType       String       @default("oauth2") // "oauth2" | "password" | "app_token"
  email          String
  accessToken    String?      @db.Text
  refreshToken   String?      @db.Text
  tokenExpiresAt DateTime?
  imapHost       String?
  imapPort       Int?
  smtpHost       String?
  smtpPort       Int?
  imapPassword   String?      @db.Text
  appId          String?
  appSecret      String?      @db.Text
  maxSyncCount   Int          @default(500)
  isActive       Boolean      @default(true)
  lastSyncAt     DateTime?
  syncCursor     String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  threads        EmailThread[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("email_connection")
}

// ─── Flowmail: Email Thread (raw email data) ───

model EmailThread {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId     String
  connection       EmailConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalThreadId String
  subject          String
  sender           String
  senderName       String?
  participants     String            @db.Text
  toRecipients     String?           @db.Text
  ccRecipients     String?           @db.Text
  snippet          String?           @db.Text
  bodyHtml         String?           @db.Text
  bodyText         String?           @db.Text
  rawPayload       String?           @db.Text
  messageId        String?           // RFC Message-ID header, for threading replies
  entityId         String?
  entity           FlowEntity?       @relation(fields: [entityId], references: [id])
  attachments      EmailAttachment[]
  receivedAt       DateTime
  processedAt      DateTime?
  createdAt        DateTime          @default(now())

  @@unique([connectionId, externalThreadId])
  @@index([organizationId])
  @@index([entityId])
  @@map("email_thread")
}

// ─── Flowmail: Email Attachment ───

model EmailAttachment {
  id         String      @id @default(cuid())
  threadId   String
  thread     EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String?
  size       Int?
  externalId String
  contentId  String?
  createdAt  DateTime    @default(now())

  @@index([threadId])
  @@map("email_attachment")
}

// ─── Flowmail: Category (dynamic, user-defined) ───

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  icon           String       @default("InboxIcon")
  color          String       @default("#6366f1")
  aiPrompt       String       @db.Text @default("")
  sortOrder      Int          @default(0)
  isDefault      Boolean      @default(false)
  entities       FlowEntity[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("category")
}

// ─── Flowmail: Structured Entity (core model) ───

enum EntityType {
  APPROVAL
  REPORT
  ISSUE
  FEEDBACK
}

model FlowEntity {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type            EntityType
  categoryId      String?
  category        Category?       @relation(fields: [categoryId], references: [id])
  title           String
  status          String          @default("pending")
  extractedFields String          @db.Text @default("{}")
  aiSummary       String?         @db.Text
  aiConfidence    Float?
  requiresReview  Boolean         @default(false)
  assigneeId      String?
  assignee        User?           @relation("AssignedEntities", fields: [assigneeId], references: [id])
  threads         EmailThread[]
  timeline        TimelineEvent[]
  notifications   Notification[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId, type])
  @@index([organizationId, categoryId])
  @@index([organizationId, status])
  @@index([assigneeId])
  @@map("flow_entity")
}

// ─── Flowmail: Timeline Event ───

model TimelineEvent {
  id        String     @id @default(cuid())
  entityId  String
  entity    FlowEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  type      String     // "email_received" | "email_sent" | "status_changed" | "action_taken" | "ai_summary"
  content   String     @db.Text
  metadata  String?    @db.Text
  actorId   String?
  actor     User?      @relation("TimelineActor", fields: [actorId], references: [id])
  createdAt DateTime   @default(now())

  @@index([entityId])
  @@map("timeline_event")
}

// ─── Flowmail: Notification ───

enum NotificationType {
  DEADLINE_WARNING
  DEADLINE_OVERDUE
  APPROVAL_TIMEOUT
  NEW_ENTITY
  STATUS_CHANGED
  DAILY_DIGEST
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  body           String           @db.Text
  entityId       String?
  entity         FlowEntity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  isRead         Boolean          @default(false)
  sentViaEmail   Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([userId, isRead])
  @@index([organizationId])
  @@index([entityId])
  @@map("notification")
}

// ─── Flowmail: API Token (MCP / Agent 鉴权) ───

model ApiToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  tokenHash      String       @unique
  tokenPrefix    String
  scopes         String       @default("mcp:full")
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([tokenHash])
  @@map("api_token")
}
