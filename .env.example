# Database
DATABASE_URL="YOUR_DATABASE_CONNECTION_STRING"
# For local development with Docker Compose:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supastarter"
# ... if you use Supabase
DIRECT_URL=""

# Site url
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Docs url
NEXT_PUBLIC_DOCS_URL="http://localhost:3001"

# Field-level encryption for sensitive data (OAuth tokens, IMAP passwords)
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=""

# Authentication
BETTER_AUTH_SECRET="A_RANDOM_SECRET_STRING"
# 注册门禁：逗号分隔的邀请码（服务端校验）。非空且插件启用时，无有效码无法邮箱注册（组织邀请邮箱可豁免）。
FLOWMAIL_INVITE_CODES=""
# 营销页/注册页是否展示邀请码流程（需与 FLOWMAIL_INVITE_CODES 同时配置才完整生效）
NEXT_PUBLIC_INVITE_CODE_REQUIRED="false"
# ... for Github
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
# ... for Google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Mails
# ... with Resend
RESEND_API_KEY=""

# Contact form
CONTACT_FORM_TO_MAIL="hello@flowmail.ai"

# Payments
# ... with Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Product price ids
NEXT_PUBLIC_PRICE_ID_PRO_MONTHLY="asdf"
NEXT_PUBLIC_PRICE_ID_PRO_YEARLY="asdf"
NEXT_PUBLIC_PRICE_ID_LIFETIME="asdf"

# Storage
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION=""
NEXT_PUBLIC_AVATARS_BUCKET_NAME="avatars"
# For local development with Docker Compose (MinIO):
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"

# AI Gateway (OpenAI-compatible, e.g. Zerail, OneAPI, OpenRouter)
AI_GATEWAY_BASE_URL=""
AI_GATEWAY_API_KEY=""
AI_FAST_MODEL="Kimi-K2.5"
AI_TEXT_MODEL="Kimi-K2.5"
AI_REASONING_MODEL="Kimi-K2.5"

# AI (fallback if not using gateway)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Cron jobs
CRON_SECRET=""

# ============================================================
# Flowmail specific
# ============================================================

# Gmail Integration (MVP)
# 服务端用于换 token
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
# 前端用于发起 OAuth 授权
NEXT_PUBLIC_GMAIL_CLIENT_ID=""

# 飞书邮箱：在 SaaS「邮箱连接」页填写企业自建应用的 App ID / Secret（OAuth），无需在此配置。
# 钉钉 / 企业微信邮箱：同上；后续可统一做 token 自动刷新（当前已支持飞书）。

# Inbound Email (Drop Box)
# Resend webhook signing secret for inbound email verification
RESEND_WEBHOOK_SECRET=""
# Custom domain for inbound emails (default: inbound.flowmail.ai)
INBOUND_EMAIL_DOMAIN="inbound.flowmail.ai"

# MCP Server
FLOWMAIL_MCP_SECRET=""
